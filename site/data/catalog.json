                    {
                        "name": "/gamemode",
                        "description": {
                            "en": "Switch your own gamemode, restricted to the creative sandbox world.",
                            "sv": "Byt ditt eget spelläge, begränsat till den kreativa sandlådevärlden."
                        }
                    }
                ],
                "order": 10
            },
