                        }
                    },
                    {
                        "name": "/tpa /tpahere /tpaccept /tpacancel",
                        "description": {
                            "en": "Request to teleport to another player, or invite them to you.",
                            "sv": "Begär att teleportera till en annan spelare, eller bjud in dem till dig."
                        }
                    },
                    {
                        "name": "/world /mv list /mvtp",
                        "description": {
